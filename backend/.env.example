# ===========================================
# 教学平台后端 - 环境变量示例
# 复制本文件为 .env 并根据实际环境修改
# ===========================================

# 基础配置（生产环境请修改为 production）
NODE_ENV=production
HOST=0.0.0.0
PORT=8081
SOCKET_PORT=8081

# 安全配置（务必修改为随机字符串）
JWT_SECRET=请填写随机字符串
JWT_EXPIRES_IN=7d

# CORS 配置（多个域名使用逗号分隔）
CORS_ORIGIN=https://class.codebn.cn
CORS_CREDENTIALS=true

# 接口限流
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
# 生产环境禁用跳过限流
SKIP_RATE_LIMIT=false

# 登录节流（防暴力破解）
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8
LOGIN_BLOCK_MS=900000

# 请求体大小限制
REQUEST_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# 上传文件大小限制（MB）
UPLOAD_FILE_SIZE_LIMIT_MB=100

# 数据库配置（按宝塔数据库信息填写）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teaching_platform
DB_USER=teaching_user
DB_PASSWORD=请填写数据库密码

# 静态资源与URL
API_URL=https://class.codebn.cn
STATIC_URL=/uploads

# 强制使用OSS（生产环境建议 true）
FORCE_OSS=true

# HTTP服务器超时与头部限制（防慢速攻击）
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=0
MAX_HEADERS_COUNT=2000

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# 阿里云OSS对象存储配置
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=teaching-platform-files

# 邮件通知（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
