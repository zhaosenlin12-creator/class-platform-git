# ===========================================
# 教学平台后端 - 本地开发环境配置
# 复制本文件为 .env 用于本地开发
# ===========================================

# 基础配置
NODE_ENV=development
HOST=0.0.0.0
PORT=8081
SOCKET_PORT=8081

# 安全配置
JWT_SECRET=replace_with_local_dev_secret
JWT_EXPIRES_IN=7d

# CORS 配置（本地开发）
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
CORS_CREDENTIALS=true

# 接口限流（本地开发可跳过）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
SKIP_RATE_LIMIT=true

# 登录节流（本地开发可放宽）
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=20
LOGIN_BLOCK_MS=300000

# 请求体大小限制
REQUEST_BODY_LIMIT=5mb
URLENCODED_BODY_LIMIT=5mb

# 上传文件大小限制（MB）
UPLOAD_FILE_SIZE_LIMIT_MB=100

# 数据库配置（本地MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teaching_platform
DB_USER=root
DB_PASSWORD=你的本地MySQL密码

# 静态资源与URL
API_URL=http://localhost:8081
STATIC_URL=/uploads

# HTTP服务器超时与头部限制（防慢速攻击）
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=0
MAX_HEADERS_COUNT=2000

# 日志配置
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# 阿里云OSS（可选，本地开发可不配置）
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
