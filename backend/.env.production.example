# ===========================================
# 生产环境配置示例文件
# 部署前请复制此文件为 .env 并填写真实值
# ===========================================

# ===========================================
# 运行环境配置
# ===========================================
NODE_ENV=production
HOST=0.0.0.0
PORT=8081
SOCKET_PORT=8081

# ===========================================
# 数据库配置 (⚠️ 必须修改)
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teaching_platform
DB_USER=teaching_user
DB_PASSWORD=your_database_password_here

# ===========================================
# JWT配置 (⚠️ 必须修改为强密钥)
# ===========================================
# 建议使用至少32位的随机字符串
# 可以用这个命令生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# ===========================================
# CORS配置 (⚠️ 必须设置为您的域名)
# ===========================================
# 生产环境必须设置为实际域名，支持多个域名用逗号分隔
# 示例: https://class.codebn.cn,https://www.class.codebn.cn
CORS_ORIGIN=https://class.codebn.cn
CORS_CREDENTIALS=true

# ===========================================
# 接口限流配置
# ===========================================
# 时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=900000
# 最大请求数
RATE_LIMIT_MAX_REQUESTS=100
# 是否跳过限流（生产环境建议设为false）
SKIP_RATE_LIMIT=false

# ===========================================
# 登录节流（防暴力破解）
# ===========================================
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8
LOGIN_BLOCK_MS=900000

# ===========================================
# 请求体大小限制
# ===========================================
REQUEST_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb

# ===========================================
# 上传文件大小限制（MB）
# ===========================================
UPLOAD_FILE_SIZE_LIMIT_MB=100

# ===========================================
# 代理信任配置
# ===========================================
# 如果使用Nginx反向代理，需要启用
TRUST_PROXY_ENABLED=true
TRUST_PROXY_VALUE=1

# ===========================================
# API配置
# ===========================================
# API访问地址（用于生成完整URL）
API_URL=https://class.codebn.cn
# 静态文件URL路径
STATIC_URL=/uploads

# 强制使用OSS（生产环境建议 true）
FORCE_OSS=true

# ===========================================
# HTTP服务器超时与头部限制（防慢速攻击）
# ===========================================
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=65000
REQUEST_TIMEOUT_MS=0
MAX_HEADERS_COUNT=2000

# ===========================================
# 可选：阿里云OSS配置（如果使用OSS存储）
# ===========================================
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# OSS_BUCKET=your_bucket_name
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ===========================================
# 日志配置
# ===========================================
# LOG_LEVEL=info
# LOG_MAX_FILES=7d
# LOG_MAX_SIZE=20m
