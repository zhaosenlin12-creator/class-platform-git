{
  "name": "teaching-platform-backend",
  "version": "1.0.0",
  "description": "教学平台后端API服务 - Node.js + Express + Sequelize + MySQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:class-schedule": "node scripts/add-class-schedule-fields.js",
    "check:syntax": "node scripts/check-syntax.js",
    "audit:prod": "npm audit --omit=dev",
    "verify:ci": "npm run check:syntax && npm run audit:prod",
    "test": "npm run check:syntax"
  },
  "keywords": [
    "teaching",
    "education",
    "platform",
    "express",
    "mysql",
    "sequelize"
  ],
  "author": "Teaching Platform Team",
  "license": "MIT",
  "dependencies": {
    "ali-oss": "^6.23.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.6.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "fast-check": "^4.5.3",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
