# Server Guard environment overrides
# Copy to /etc/sysconfig/server-guard and adjust

# Webhook for alerts (optional)
ALERT_WEBHOOK_URL=
ALERT_TYPE=dingtalk   # dingtalk|wecom|generic

# Process allowlist regex to avoid false positives
ALLOWLIST_REGEX=node|teaching-platform|mysqld|nginx|redis

# Optional tuning
# CPU_THRESHOLD=200
# INTERVAL=60
