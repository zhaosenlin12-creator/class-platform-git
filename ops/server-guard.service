[Unit]
Description=Server Guard (cryptominer/persistence audit)
After=network.target

[Service]
Type=simple
User=root

# Active response defaults (enforce). Set DRY_RUN=1 to audit only.
Environment=MODE=enforce
Environment=INTERVAL=60
Environment=LOG_FILE=/var/log/server-guard.log
Environment=DRY_RUN=0
Environment=AUTO_KILL_ON_SUSPECT=1
Environment=AUTO_DISABLE_PERSISTENCE=1
Environment=QUARANTINE_DIR=/var/lib/server-guard/quarantine
Environment=ALERT_CMD=/usr/local/sbin/server-guard-alert.sh
EnvironmentFile=-/etc/sysconfig/server-guard

# Install script to this path (or adjust ExecStart accordingly)
ExecStart=/usr/local/sbin/server-guard.sh --daemon
Restart=always
RestartSec=5

# Hardening (best-effort; remove if your distro/systemd is older)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
