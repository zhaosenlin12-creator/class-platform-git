{
  "name": "vue-antd-jeecg",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "pre": "yarn --registry https://registry.npm.taobao.org || cnpm install || npm install --registry https://registry.npm.taobao.org ",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:analyze": "cross-env NODE_ENV=production vue-cli-service build --config vue.config.analyzer.js",
    "build:prod": "cross-env NODE_ENV=production vue-cli-service build --mode production",
    "analyze": "npm run build:analyze",
    "bundle-report": "webpack-bundle-analyzer dist/static/js/*.js",
    "bundle-analysis": "node scripts/bundle-analysis.js",
    "verify:homepage-budget": "node scripts/verify-homepage-budget.js",
    "verify:homepage-features": "node scripts/verify-homepage-features.js",
    "verify:runtime-base-urls": "node scripts/verify-runtime-base-urls.js",
    "verify:editor-returns": "node scripts/verify-editor-returns.js",
    "verify:editor-workflows": "node scripts/verify-editor-workflows.js",
    "test:integration": "node tests/integration/run-integration-tests.js",
    "test:health": "node tests/integration/IntegrationTestSuite.js",
    "lint": "vue-cli-service lint",
    "verify:homepage-branding": "node scripts/verify-homepage-branding.js"
  },
  "dependencies": {
    "@antv/data-set": "^0.11.2",
    "@jeecg/antd-online-beta220": "^1.0.1",
    "@tinymce/tinymce-vue": "^2.1.0",
    "ant-design-vue": "^1.6.3",
    "area-data": "^5.0.6",
    "axios": "^0.18.0",
    "babel-core": "^6.26.3",
    "babel-loader": "7",
    "clipboard": "^2.0.4",
    "codemirror": "^5.46.0",
    "dayjs": "^1.8.0",
    "echarts": "^6.0.0",
    "enquire.js": "^2.1.6",
    "js-cookie": "^2.2.0",
    "lodash.get": "^4.4.2",
    "lodash.pick": "^4.4.0",
    "md5": "^2.2.1",
    "moment": "^2.30.1",
    "nprogress": "^0.2.0",
    "pdfjs-dist": "^2.16.105",
    "prismjs": "^1.26.0",
    "qrcode.vue": "^1.6.2",
    "socket.io-client": "^4.7.5",
    "swiper": "^5.4.5",
    "tinymce": "^5.3.2",
    "vcolorpicker": "^1.1.0",
    "viser-vue": "^2.4.4",
    "vue": "^2.6.10",
    "vue-area-linkage": "^5.1.0",
    "vue-awesome-swiper": "^4.1.1",
    "vue-cropper": "^0.4.8",
    "vue-i18n": "^8.7.0",
    "vue-loader": "^15.7.0",
    "vue-ls": "^3.2.0",
    "vue-photo-preview": "^1.1.3",
    "vue-print-nb-jeecg": "^1.0.9",
    "vue-router": "^3.0.1",
    "vue-splitpane": "^1.0.4",
    "vuedraggable": "^2.20.0",
    "vuex": "^3.1.0"
  },
  "devDependencies": {
    "@babel/polyfill": "^7.2.5",
    "@vue/cli-plugin-babel": "^3.3.0",
    "@vue/cli-plugin-eslint": "^3.3.0",
    "@vue/cli-service": "^3.3.0",
    "@vue/eslint-config-standard": "^4.0.0",
    "babel-eslint": "7.2.3",
    "babel-plugin-import": "^1.13.0",
    "compression-webpack-plugin": "^3.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^5.16.0",
    "eslint-plugin-unused-imports": "0.1.3",
    "eslint-plugin-vue": "^5.1.0",
    "html-webpack-plugin": "^4.2.0",
    "less": "^3.9.0",
    "less-loader": "^4.1.0",
    "terser-webpack-plugin": "^4.2.3",
    "vue-template-compiler": "^2.6.10",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/strongly-recommended",
      "@vue/standard"
    ],
    "plugins": [
      "unused-imports"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {
      "no-unused-vars": "off",
      "unused-imports/no-unused-imports": "error",
      "unused-imports/no-unused-vars": [
        "warn",
        {
          "vars": "all",
          "varsIgnorePattern": "^_",
          "args": "after-used",
          "argsIgnorePattern": "^_"
        }
      ],
      "generator-star-spacing": "off",
      "no-mixed-operators": 0,
      "vue/max-attributes-per-line": [
        2,
        {
          "singleline": 5,
          "multiline": {
            "max": 1,
            "allowFirstLine": false
          }
        }
      ],
      "vue/attribute-hyphenation": 0,
      "vue/html-self-closing": 0,
      "vue/component-name-in-template-casing": 0,
      "vue/html-closing-bracket-spacing": 0,
      "vue/singleline-html-element-content-newline": 0,
      "vue/no-unused-components": 0,
      "vue/multiline-html-element-content-newline": 0,
      "vue/no-use-v-if-with-v-for": 0,
      "vue/html-closing-bracket-newline": 0,
      "vue/no-parsing-error": 0,
      "no-console": 0,
      "no-tabs": 0,
      "indent": [
        1,
        4
      ]
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
